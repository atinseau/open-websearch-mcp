{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "proseWrap": "preserve",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  // Captured pages are evidence, reformatting them would change what the test
  // reads.
  "ignorePatterns": [
    ".worktree/**",
    "tests/architecture/fixtures/**",
    "tests/extraction/fixtures/**",
  ],
}
