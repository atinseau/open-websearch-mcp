{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-websearch-mcp.local/schemas/teacher-fixture.schema.json",
  "title": "Teacher fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "question",
    "locale",
    "derived_by",
    "verified_by",
    "verification_status",
    "claims",
    "rejected_claims"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "derived_by": { "const": "codex" },
    "verified_by": { "enum": ["grounding", "claude"] },
    "verification_status": { "const": "accepted" },
    "claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "required_concepts",
          "acceptable_patterns",
          "sources",
          "evidence_passages",
          "weight",
          "provenance"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "required_concepts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptable_patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "equivalent_urls"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "equivalent_urls": {
                  "type": "array",
                  "items": { "type": "string", "format": "uri" }
                }
              }
            }
          },
          "evidence_passages": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "text"],
              "properties": {
                "url": { "type": "string", "format": "uri" },
                "text": { "type": "string", "minLength": 1, "maxLength": 1200 }
              }
            }
          },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "codex_run"],
            "properties": {
              "mode": { "enum": ["trace_grounded", "trace_supported", "mutually_validated"] },
              "codex_run": { "type": "string", "minLength": 1 },
              "claude_run": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "mode": { "const": "trace_grounded" } } },
                "then": { "not": { "required": ["claude_run"] } },
                "else": { "required": ["claude_run"] }
              }
            ]
          }
        }
      }
    },
    "rejected_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "reason"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
