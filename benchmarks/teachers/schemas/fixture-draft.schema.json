{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "rejected_claims"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "required_concepts",
          "acceptable_patterns",
          "sources",
          "evidence_passages",
          "weight"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "required_concepts": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "acceptable_patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "equivalent_urls"],
              "properties": {
                "url": { "type": "string", "minLength": 8 },
                "equivalent_urls": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 8 }
                }
              }
            }
          },
          "evidence_passages": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "text"],
              "properties": {
                "url": { "type": "string", "minLength": 8 },
                "text": { "type": "string", "minLength": 1, "maxLength": 1200 }
              }
            }
          },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 }
        }
      }
    },
    "rejected_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "reason"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
