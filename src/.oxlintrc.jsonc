{
  // ARCH-007 numeric limits for product source.
  //
  // A nested configuration keeps the root config strict for every path while
  // applying these thresholds only where they currently hold. `scripts/` and
  // `benchmarks/` predate the rule and violate it; both are outside FND-001's
  // write set, so their compliance is recorded as debt in ADR-0008 rather than
  // silently exempted.
  //
  // `bun run lint:limits` loads this file by nesting, so the root `lint` script
  // keeps `--disable-nested-config` and the ARCH-008 guard against alternate
  // `-c` configurations stays intact.
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "rules": {
    "complexity": ["error", 10],
    "max-depth": ["error", 4],
    "max-lines": ["error", 300],
    "max-lines-per-function": ["error", 60],
    "max-params": ["error", 5],
  },
}
